{
  "name": "@deepseek-ai/dsh-experimental-skill-index",
  "description": "Dragon Engine asset index reader for the DeepSeek Harness — exposes dragon-assets/index/*.jsonl as a Cordis Service",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/skill-index"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {

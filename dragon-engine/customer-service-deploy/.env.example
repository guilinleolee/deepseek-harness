# ============================================================
# 客服工作台 V0.1 · 环境变量模板
# 复制本文件为 .env 并填入实际值
# 警告：.env 不要提交到 git
# ============================================================

# ---- 基础环境 ----
NODE_ENV=development

# ---- PostgreSQL ----
POSTGRES_PASSWORD=cs_secret_2026_change_me

# ---- MinIO（对象存储）----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_2026_change_me
MINIO_BUCKET=cs-audio

# ---- FastGPT ----
FASTGPT_ROOT_PASSWORD=fastgpt_secret_2026_change_me
FASTGPT_API_KEY=fastgpt

# ---- LLM：MiniMax（OpenAI 兼容）----
# 从 dragon-engine/.env 复制 OPENAI_API_KEY / OPENAI_BASE_URL
OPENAI_BASE_URL=https://api.minimax.chat/v1
OPENAI_API_KEY=sk-cp-your-key-here
OPENAI_MODEL=MiniMax-M3

# ---- ASR：faster-whisper 本地模型 ----
WHISPER_MODEL=small

# ---- TTS：edge-tts 微软免费 ----
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# ---- 业务阈值 ----
AUTO_REPLY_THRESHOLD=0.75
TRANSFER_HUMAN_THRESHOLD=0.40


{
  "$schema": "../hooks-schema.json",
  "hookVersion": "2.1.0",
  "description": "🐉 天龙引擎Hook配置 V8.56 - GSD P2集成（TDD工作流融合 + 并行波次执行）",

  "hooks": {
    "postToolUse": ["./postToolUse/nine-dragons-log-watcher.js", "./postToolUse/nine-dragons-task-manager-hook.js", "./postToolUse/lessons-logger.js"],
    "preResponse": [],
    "userPromptSubmit": ["./userPromptSubmit/dragon-shortcut-syntax-hook.js"],
    "preToolUse": ["./postToolUse/nine-dragons-log-watcher.js"],
    "Stop": [],
    "SessionEnd": ["./session-end/shared-memory-session-end.js"]
  },

  "on_demand": {
    "openclaw-backup-restore": {
      "command": "./skills/openclaw-backup/scripts/restore.sh",
      "confirm": "⚠️ 确定要恢复备份吗？这将覆盖当前数据！",
      "requireUserApproval": true,
      "suggestDryRun": true,
      "dryRunFlag": "--dry-run"
    },
    "paperclip-governance-rollback": {
      "command": "./skills/paperclip-governance/scripts/rollback.sh",
      "confirm": "⚠️ 确定要回滚到指定版本吗？此操作不可逆！",
      "requireUserApproval": true
    },
    "paperclip-heartbeat-modify": {
      "command": "./skills/paperclip-heartbeat/scripts/heartbeat.ts",
      "confirm": "⏰ 确定要修改心跳调度吗？可能影响生产任务。",
      "level": "medium"
    },
    "x-publisher-post": {
      "command": "./skills/x-publisher/scripts/publish.sh",
      "confirm": "📤 确定要发布到X/Twitter吗？内容将公开可见。",
      "requireUserApproval": true
    },
    "baoyu-post-to-wechat": {
      "command": "./skills/baoyu-post-to-wechat/scripts/post_to_wechat.py",
      "confirm": "📤 确定要发布到微信公众号吗？",
      "requireUserApproval": true
    },
    "baoyu-post-to-weibo": {
      "command": "./skills/baoyu-post-to-weibo/scripts/post_to_weibo.py",
      "confirm": "📤 确定要发布到微博吗？内容将公开可见。",
      "requireUserApproval": true
    },
    "scrapy-anti-ban-spider": {
      "command": "./skills/scrapy-anti-ban/scripts/spider.py",
      "confirm": "🕷️ 确定要启动爬虫吗？请确保符合目标网站服务条款。",
      "level": "medium"
    }
  },

  "settings": {
    "dragonCommander": {
      "enabled": true,
      "commanderName": "李依依",
      "nickname": "一一",
      "autoAnalysis": true,
      "autoDecomposition": true,
      "parallelTasks": 3,
      "maxRetries": 3,
      "promptRef": "../prompts/liyiyi-commander-system-prompt.md"
    },
    "completionEnforcer": {
      "enabled": true,
      "maxRetries": 3,
      "checkConversationalMode": true,
      "conversationalWindow": 5,
      "tokenLimitThreshold": 0.8,
      "warnOnUserPrompt": true
    },
    "logWatcher": {
      "enabled": true,
      "errorLogDir": ".claude/logs/errors",
      "dangerousCommandWarning": true,
      "earlyErrorDetection": true,
      "longRunningCommandWatch": true,
      "errorCategories": [
        "api",
        "dependency",
        "permission",
        "syntax",
        "test",
        "build",
        "git"
      ]
    },
    "taskManager": {
      "enabled": true,
      "maxParallelTasks": 3,
      "maxRetries": 3,
      "autoInferPriority": true,
      "autoInferDependencies": true,
      "persistencePath": ".claude/task-queue.json"
    },
    "claudeception": {
      "enabled": true,
      "autoEvaluate": true,
      "qualityGates": {
        "requiresDiscovery": true,
        "mustBeReusable": true,
        "mustBeVerified": true,
        "specificTriggers": true
      },
      "extractionCriteria": [
        "non_obvious_solutions",
        "project_specific_patterns",
        "tool_integration_knowledge",
        "error_resolution",
        "workflow_optimizations"
      ],
      "skillOutputPath": "~/.claude/skills/learned/"
    },
    "planHealthChecker": {
      "enabled": true,
      "autoReplan": true,
      "checkInterval": 60000,
      "replanCooldown": 300000,
      "thresholds": {
        "completionRate": { "healthy": 0.5, "warning": 0.3 },
        "errorRate": { "healthy": 0.2, "warning": 0.4 },
        "timeDeviation": { "healthy": 1.5, "warning": 2.0 }
      }
    },
    "lessonsLogger": {
      "enabled": true,
      "minRetryCount": 3,
      "checkUserCorrections": true,
      "checkRepetitiveErrors": true,
      "maxLessonsPerSession": 5,
      "lessonsPath": ".claude/lessons.md"
    },
    "staffReviewTrigger": {
      "enabled": true,
      "thresholds": {
        "maxFiles": 5,
        "maxLines": 200,
        "maxComplexity": 15
      },
      "autoTrigger": {
        "high": false,
        "medium": false,
        "low": false
      }
    },
    "openclawZeroPolling": {
      "enabled": true,
      "stateDir": "~/.openclaw/workspace/state",
      "dedupWindow": 5000,
      "lockTimeout": 30000,
      "maxFileTreeLines": 30,
      "wakeEventEnabled": false,
      "logLevel": "info"
    },
    "limeiSecretary": {
      "enabled": true,
      "version": "8.0",
      "thinkingEngines": {
        "kahnemann_s1": "卡尼曼系统1（快思考）",
        "kahnemann_s2": "卡尼曼系统2（慢思考）",
        "munger": "芒格多元思维",
        "musk": "马斯克第一性原理",
        "buffett": "巴菲特能力圈",
        "drucker": "德鲁克目标管理"
      },
      "autoMemoryUpdate": true,
      "autoLessonRecording": true,
      "styleMatchingThreshold": 95
    },
    "sessionManager": {
      "enabled": true,
      "version": "7.5",
      "autoArchiveHours": 1,
      "maxActiveSessions": 10,
      "statePath": "~/.claude/.session-state.json"
    },
    "tokenTracker": {
      "enabled": true,
      "version": "7.5",
      "pricing": {
        "claude-opus-4-6": { "input": 15, "output": 75 },
        "claude-sonnet-4-6": { "input": 3, "output": 15 },
        "claude-sonnet-4": { "input": 3, "output": 15 },
        "claude-haiku-4-5": { "input": 0.80, "output": 4 },
        "claude-haiku": { "input": 0.80, "output": 4 }
      },
      "maxRecords": 1000,
      "tokenPath": "~/.claude/.token-usage.json"
    },
    "tokenEstimator": {
      "enabled": true,
      "version": "1.0.0",
      "description": "CJK感知的Token估算器 - Phase 1.1",
      "ratios": {
        "cjk": 1.0,
        "ascii": 4.0,
        "mixed": 3.0
      },
      "truncateSuffix": "...[已截断]",
      "budgetThresholds": {
        "warning": 0.7,
        "critical": 0.85
      }
    },
    "obsidianTruncator": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Obsidian记忆截断器 - Phase 1.2",
      "maxTokens": 8000,
      "budgetsByType": {
        "lesson": 4000,
        "decision": 2000,
        "concept": 2000
      },
      "timeDecay": {
        "enabled": true,
        "decayDays": 30,
        "decayFactor": 0.5
      }
    },
    "skillRouter": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Skill快速路由 - Phase 1.3",
      "cacheEnabled": true,
      "cacheTTL": 3600000,
      "maxResults": 5,
      "minMatchScore": 0.3
    },
    "lazySkillLoader": {
      "enabled": true,
      "version": "1.0.0",
      "description": "按需Skill加载 - Phase 1.4",
      "maxCacheSize": 10,
      "maxCacheBytes": 524288,
      "budgetThreshold": 0.3
    },
    "contextBudgetGovernor": {
      "enabled": true,
      "version": "1.0.0",
      "description": "上下文预算治理 - Phase 2.1",
      "warningThreshold": 0.6,
      "criticalThreshold": 0.85,
      "contextReserveFloor": 20000,
      "smallModelReserveRatio": 0.125,
      "largeContextThreshold": 64000
    },
    "toolCompressor": {
      "enabled": true,
      "version": "1.0.0",
      "description": "工具输出压缩 - Phase 2.2",
      "truncateChars": 16000,
      "summarizeChars": 50000
    },
    "sessionCompactor": {
      "enabled": true,
      "version": "1.0.0",
      "description": "会话压缩 - Phase 2.3",
      "preserveRatio": 0.3,
      "minPreserve": 3,
      "maxPreserve": 50
    },
    "promptCache": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Prompt缓存延续 - Phase 2.4",
      "cacheTTL": 3600000
    },
    "modelRouter": {
      "enabled": true,
      "version": "1.0.0",
      "description": "模型路由 - Phase 3.1",
      "tiers": {
        "c0": "qwen3.7-flash",
        "c1": "deepseek-v4-flash",
        "c2": "glm-5.2",
        "c3": "claude-opus-4-6"
      },
      "complexityThresholds": {
        "low": 0.2,
        "medium": 0.5,
        "high": 0.8
      }
    },
    "tokenAudit": {
      "enabled": true,
      "version": "1.0.0",
      "description": "Token优化审计 - Phase 3.2",
      "maxEntries": 10000,
      "retentionDays": 30
    },
    "interactionMode": {
      "enabled": true,
      "version": "7.5",
      "modes": ["code", "plan", "ask"],
      "defaultMode": "code",
      "statePath": "~/.claude/.interaction-mode.json"
    },
    "modelSwitcher": {
      "enabled": true,
      "version": "7.5",
      "models": ["claude-opus-4-6", "claude-sonnet-4-6", "claude-haiku-4-5", "qwen3.5-plus"],
      "configPath": "~/.claude/.model-config.json"
    },
    "metaReview": {
      "enabled": true,
      "version": "8.14",
      "maxDepth": 3,
      "triggerWeights": {
        "reviewer_blind_spot": { "weight": 0.9, "priority": "HIGH" },
        "high_risk_decision": { "weight": 0.85, "priority": "HIGH" },
        "user_dissatisfaction": { "weight": 0.6, "priority": "MEDIUM" },
        "governance_incomplete": { "weight": 0.7, "priority": "MEDIUM" },
        "triple_failure": { "weight": 0.95, "priority": "HIGH" }
      },
      "highRiskThreshold": {
        "cost": 1000,
        "duration": 14,
        "files": 10
      },
      "metaLessonsPath": "~/.claude/memory/meta-lessons.yaml"
    },
    "obsidianMemory": {
      "enabled": true,
      "version": "1.0.0",
      "vaultPath": "C:/Users/li/Documents/Obsidian Vault",
      "writerScript": "./utility/obsidian-writer.js",
      "mirrorPath": "C:/Users/li/.claude/projects/dragon-engine/memory/obsidian-mirror",
      "schemaVersion": "1.0",
      "autoFrontmatter": true,
      "defaultArea": "Dragon-Engine",
      "preserveManualEdits": true,
      "dualWrite": true,
      "maxRetries": 3,
      "retryDelayMs": 200,
      "rotationPolicy": "monthly-archive",
      "templates": {
        "concept": "90-Templates/Concept.md",
        "decision": "90-Templates/Decision.md",
        "lesson": "90-Templates/Lesson.md",
        "person": "90-Templates/Person.md",
        "project": "90-Templates/Project.md"
      },
      "templatesIndex": "99-MOCs/MOC-Memory-System.md"
    },
    "bridge": {
      "enabled": true,
      "version": "1.0.0",
      "timeout": 300000,
      "watchdogInterval": 30000,
      "maxHeartbeatAge": 90000,
      "heartbeatInterval": 10,
      "maxRetries": 3,
      "forceKill": false,
      "unattended_mode": false,
      "unattended_behavior": "default",
      "stateDir": "~/.claude/state/bridge"
    }
  },


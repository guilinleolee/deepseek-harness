{
  "platform": "douyin",
  "name": "TikTok/抖音竖屏",
  "aspect_ratio": "9:16",
  "size": {
    "width": 1080,
    "height": 1920
  },
  "template_defaults": {
    "padding": 60,
    "corner_radius": 0
  },
  "slides": {
    "cover": {
      "gradient_presets": [
        { "name": "日落橙", "colors": ["#FF6B6B", "#FFA07A"] },
        { "name": "科技蓝", "colors": ["#667eea", "#764ba2"] },
        { "name": "清新绿", "colors": ["#11998e", "#38ef7d"] },
        { "name": "高级灰", "colors": ["#434343", "#000000"] },
        { "name": "渐变粉", "colors": ["#ee9ca7", "#ffdde1"] }
      ],
      "title": {
        "y": 700,
        "size": 80,
        "weight": "bold",
        "shadow": true
      },
      "subtitle": {
        "y": 900,
        "size": 36,
        "opacity": 0.8
      }
    },
    "content": {
      "image_top_ratio": 0.4,
      "text_top_margin": 100,
      "heading": {
        "size": 48,
        "weight": "bold",
        "line_height": 1.3
      },
      "body": {
        "size": 32,
        "line_height": 1.6,
        "max_width": 920
      }
    },
    "ending": {
      "cta_button": {
        "width": 400,
        "height": 100,
        "corner_radius": 50,
        "bg_color": "#00D4AA"
      },
      "handle": {
        "y": 1750,
        "size": 28,
        "color": "rgba(255,255,255,0.6)"
      }
    }
  }
}

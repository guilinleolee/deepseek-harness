{
  "name": "Webhook触发模板",
  "nodes": [
    {
      "id": "node_1",
      "name": "Webhook触发器",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 250],
      "parameters": {
        "httpMethod": "POST",
        "path": "my-webhook",
        "responseMode": "lastNode",
        "options": {}
      },
      "continueOnFail": false
    },
    {
      "id": "node_2",
      "name": "数据转换",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [300, 250],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": []
        },
        "options": {}
      },
      "continueOnFail": false
    },
    {
      "id": "node_3",
      "name": "响应",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 250],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "continueOnFail": false
    }
  ],
  "connections": {
    "node_1": {
      "main": [[
        {"node": "node_2", "type": "main", "index": 0}
      ]]
    },
    "node_2": {
      "main": [[
        {"node": "node_3", "type": "main", "index": 0}
      ]]
    }
  },
  "active": false,
  "settings": {},
  "天龙适配": {
    "trigger_type": "Webhook",
    "category": "automation",
    "complexity": "简单",
    "integrations": ["webhook", "set"],
    "nodes_count": 3,
    "use_cases": ["表单提交", "第三方API回调", "自动化触发"]
  }
}

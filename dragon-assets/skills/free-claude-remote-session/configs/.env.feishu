# ============================================================
# free-claude-remote-session — 飞书/Lark Bot 配置模板
# 复制到 .env.feishu.local 并填写实际值
# ============================================================

# ---- 飞书应用凭证 (从 飞书开放平台 获取) ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# ---- 访问控制 ----
# 允许 Bot 接收消息的群组/会话 ID
# 多个 ID 用逗号分隔
FEISHU_ALLOWED_CHATS=oc_xxxxxxxxxxxxxxxx,oc_yyyyyyyyyyyyyyyy

# 管理员用户的 Open ID 或 User ID
# 多个用户用逗号分隔
FEISHU_ADMIN_USERS=ou_xxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyy

# ---- Dragon Gateway 连接 ----
DRAGON_GATEWAY_HOST=localhost
DRAGON_GATEWAY_PORT=37778
DRAGON_GATEWAY_TOKEN=

# ---- HTTP 服务 ----
# Bot HTTP 服务监听端口 (飞书事件回调)
FEISHU_PORT=37777

# ---- 会话配置 ----
SESSION_TIMEOUT=3600

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 飞书特定 ----
# 是否启用卡片消息 (推荐, 支持 Markdown 格式)
USE_CARD_MESSAGE=true
# 卡片消息宽度模式
CARD_WIDE_SCREEN=true

# ============================================================
# free-claude-remote-session — Discord Bot 配置模板
# 复制到 .env.discord.local 并填写实际值
# ============================================================

# ---- Discord Bot Token (从 Discord Developer Portal 获取) ----
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ---- 访问控制 ----
# 允许 Bot 运行的服务器 (Guild) ID
# 多个服务器用逗号分隔
DISCORD_ALLOWED_GUILDS=123456789012345678,987654321098765432

# 允许 Bot 运行的频道 ID
# 多个频道用逗号分隔，留空表示不限制
DISCORD_ALLOWED_CHANNELS=

# 拥有管理员权限的角色名称
# Bot 会自动识别这些角色并赋予 ADMIN 权限
DISCORD_ADMIN_ROLES=Claude Admin,Bot Commander

# ---- Dragon Gateway 连接 ----
DRAGON_GATEWAY_HOST=localhost
DRAGON_GATEWAY_PORT=37778
DRAGON_GATEWAY_TOKEN=

# ---- 会话配置 ----
SESSION_TIMEOUT=3600

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- Discord 特定 ----
# Discord 消息最大长度 2000 字符
# Bot 会自动分段发送
MAX_MESSAGE_LENGTH=2000

# ============================================================
# free-claude-remote-session — QQ Bot 配置模板
# 复制到 .env.qq.local 并填写实际值
#
# 支持的 CQHTTP 兼容端点:
#   - go-cqhttp (https://github.com/Mrs4s/go-cqhttp)
#   - Lagrange.Core (https://github.com/LagrangeDev/Lagrange.Core)
#   - NapCat (https://github.com/NapNeko/NapCatQQ)
#
# 端点需要启用 WebSocket 正向连接 (反向 WebSocket 由 Bot 主动连接)
# ============================================================

# ---- CQHTTP WebSocket URL ----
# Bot 主动连接到 CQHTTP 端点的 WebSocket 地址
# 格式: ws://<host>:<port>/cqhttp/ws
CQHTTP_WS_URL=ws://localhost:8080/cqhttp/ws

# ---- CQHTTP 访问令牌 (与 CQHTTP 配置文件中的 access_token 一致) ----
CQHTTP_ACCESS_TOKEN=

# ---- 访问控制 ----
# 允许 Bot 响应消息的群组 ID
# 多个群组用逗号分隔，留空表示不限制
QQ_ALLOWED_GROUPS=123456789,987654321

# 允许使用 Bot 的用户 ID (QQ 号)
# 多个用户用逗号分隔，留空表示不限制
QQ_ALLOWED_USERS=

# 管理员用户 ID (拥有全部权限)
QQ_ADMIN_USERS=123456789

# ---- Dragon Gateway 连接 ----
DRAGON_GATEWAY_HOST=localhost
DRAGON_GATEWAY_PORT=37778
DRAGON_GATEWAY_TOKEN=

# ---- 会话配置 ----
SESSION_TIMEOUT=3600

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- QQ 特定 ----
# QQ 群消息最大长度 (CQ 码格式限制 500 字符)
QQ_MAX_MESSAGE_LENGTH=500
# 消息发送间隔 (毫秒)，避免触发频率限制
QQ_MESSAGE_INTERVAL=1000

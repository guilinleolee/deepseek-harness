# ============================================================
# free-claude-remote-session — Telegram Bot 配置模板
# 复制到 .env.telegram.local 并填写实际值
# ============================================================

# ---- Telegram Bot Token (从 @BotFather 获取) ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ---- 访问控制 ----
# 允许使用 Bot 的用户 ID (Telegram User ID, 非 @username)
# 多个用户用逗号分隔
TELEGRAM_ALLOWED_USERS=123456789,987654321

# 管理员用户 ID (拥有全部权限)
TELEGRAM_ADMIN_USERS=123456789

# ---- Dragon Gateway 连接 ----
DRAGON_GATEWAY_HOST=localhost
DRAGON_GATEWAY_PORT=37778
DRAGON_GATEWAY_TOKEN=

# ---- 会话配置 ----
# 单个会话最大运行时长 (秒)，默认 3600 (1小时)
SESSION_TIMEOUT=3600

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- Webhook 配置 (可选, 使用 webhook 模式) ----
# 如果不设置则使用 polling 模式
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

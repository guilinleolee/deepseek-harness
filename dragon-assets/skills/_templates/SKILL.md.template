# SKILL.md Standardized Template V1.0
# Borrowed from nomifun/nomifun-desktop v0.7.2 (Apache-2.0)
# Reference: https://github.com/nomifun/nomifun-desktop/blob/main/docs/skills/drive-nomifun/SKILL.md
#
# Usage:
#   1. Copy this file to `dragon-engine/skills/<skill-slug>/SKILL.md`
#   2. Replace angle-bracket placeholders
#   3. Run `python scripts/skill_lint.py <path>` to validate
#
# Two frontmatter modes supported (skill_lint auto-detects):
#   - minimal:  4 fields (license, triggers, name, version) — legacy compat
#   - standard: 11 fields (full) — new from stage 46
#
# This file documents the standard 11-field mode. To use minimal mode, see
# `SKILL.minimal.template` next to this file.

# === Required (11 fields) ===

name: <kebab-case-slug>           # must match directory name; lowercase + hyphens; ≤ 64 chars
version: 1.0.0                    # semver X.Y.Z (also accept legacy "V1.0" form)
base_version: 0.0                 # optional — upstream base version if borrowed
description: |
  One-line description (≤ 120 chars) + 触发词锚定.
  Must NOT enumerate triggers verbatim — triggers belong to the `triggers` array.
triggers:                          # 5-15 trigger phrases (Chinese + English mixed OK)
  - "trigger phrase 1 (中文 or English)"
  - "trigger phrase 2"
upstream:                          # optional — list upstream projects borrowed from
  - "owner/repo V0.0.0 (Protocol · Stars)"
downstream:                        # 4 agents that depend on this skill
  - agent-id V.x
  - agent-id V.x
inputs:                            # input contract
  - { name: <arg-name>, type: <str|int|bool|path|yaml|json>, required: <bool> }
outputs:                           # output contract
  - { name: <arg-name>, type: <text|yaml|json|exit-code> }
errors:                            # error code mapping
  - { code: 400, meaning: "<短描述>" }
  - { code: 429, meaning: "<限流>" }
  - { code: 500, meaning: "<服务端故障>" }

# === Required (3 fields, behavior) ===

DO:                                # exactly 6 items
  - "DO item 1"
  - "DO item 2"
  - "DO item 3"
  - "DO item 4"
  - "DO item 5"
  - "DO item 6"
DONTS:                             # exactly 10 items
  - "DON'T 1"
  - "DON'T 2"
  - "DON'T 3"
  - "DON'T 4"
  - "DON'T 5"
  - "DON'T 6"
  - "DON'T 7"
  - "DON'T 8"
  - "DON'T 9"
  - "DON'T 10"

# === Required (1 field, concrete) ===

example:                           # at least 1 fully runnable example
  cli: |
    <one specific shell command that actually works>
  output: |
    <the expected output (truncated to relevant section)>


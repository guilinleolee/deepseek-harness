# browser-use-bridge 环境变量模板
# 复制为 .env 并填入真实 key · .env 已加入 .gitignore

# ===== Cloud SDK (推荐) =====
# 注册:https://cloud.browser-use.com/new-api-key
# 20 req/min · 0 月度上限
BROWSER_USE_API_KEY=your-browser-use-cloud-key

# ===== 自带 LLM provider keys (可选) =====
# 若使用 ChatBrowserUse 走 cloud LLM · 不需要这些
# 若使用 ChatOpenAI / ChatAnthropic / ChatGoogle 直接调上游 · 需要对应 key
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AIza-...

# ===== Profile sync (可选) =====
# 从远程浏览器同步认证 profile · 需安装 profile-use
# https://github.com/browser-use/profile-use-releases/releases/latest
# BROWSER_USE_PROFILE_SYNC_URL=https://...
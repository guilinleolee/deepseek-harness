    def _build_url(self, path: str, params: Dict[str, Any] = None) -> str:
        url = f"{self.base_url}{path}"
        if params:
            # Filter out None values
            filtered_params = {k: v for k, v in params.items() if v is not None}
            if filtered_params:
                # Handle list values
                query_parts = []
                for k, v in filtered_params.items():
                    if isinstance(v, list):
                        for item in v:
                            query_parts.append(f"{k}={urllib.parse.quote(str(item))}")
                    else:
                        query_parts.append(f"{k}={urllib.parse.quote(str(v))}")
                url = f"{url}?{'&'.join(query_parts)}"
        return url

    def _request(
        self,
        method: str,
        path: str,
        params: Dict[str, Any] = None,
        data: Any = None,
        headers: Dict[str, str] = None,
    ) -> Any:
        url = self._build_url(path, params)
        request_headers = {**self.default_headers}
        if headers:
            request_headers.update(headers)

        request_data = None
        if data is not None:
            if isinstance(data, (dict, list)):
                request_data = json.dumps(data).encode()
            elif isinstance(data, str):
                request_data = data.encode()
            elif isinstance(data, bytes):
                request_data = data

        request = urllib.request.Request(
            url,
            data=request_data,
            headers=request_headers,
            method=method
        )

        last_error = None
        for attempt in range(self.max_retries):
            try:
                with urllib.request.urlopen(request, timeout=self.timeout) as response:
                    if response.status == 204:
                        return None
                    response_body = response.read().decode("utf-8")
                    if response_body:
                        return json.loads(response_body)
                    return None

            except urllib.error.HTTPError as e:
                error_body = e.read().decode("utf-8") if e.fp else ""
                status_code = e.code

                if status_code == 429:
                    # Rate limited - exponential backoff
                    retry_after = float(e.headers.get("Retry-After", self.retry_delay))
                    time.sleep(retry_after * (2 ** attempt))
                    last_error = RateLimitError(
                        f"Rate limit exceeded",
                        status_code=status_code,
                        response=error_body
                    )
                    continue

                elif status_code == 404:
                    raise NotFoundError(
                        f"Resource not found: {path}",
                        status_code=status_code,
                        response=error_body
                    )

                elif status_code == 401:
                    raise UnauthorizedError(
                        f"Authentication failed",
                        status_code=status_code,
                        response=error_body
                    )

                elif status_code == 422:
                    raise ValidationError(
                        f"Validation failed",
                        status_code=status_code,
                        response=error_body
                    )

                else:
                    raise APIError(
                        f"HTTP {status_code}: {error_body[:500]}",
                        status_code=status_code,
                        response=error_body
                    )

            except urllib.error.URLError as e:
                last_error = APIError(f"Network error: {e.reason}")
                if attempt < self.max_retries - 1:
                    time.sleep(self.retry_delay * (2 ** attempt))
                    continue
                raise last_error

        raise last_error


/**
 * {{api_name}} API Client
 * Generated from OpenAPI spec: {{api_version}}
{{#if description}}
 * {{description}}
{{/if}}
 */
export interface ClientConfig {
  baseUrl: string;
{{#if auth}}
{{#if (eq auth_type "bearer")}}
  token: string;
{{/if}}
{{#if (eq auth_type "api_key")}}
  apiKey: string;
  apiKeyHeader?: string;
{{/if}}
{{#if (eq auth_type "basic")}}
  username: string;
  password: string;
{{/if}}
{{#if (eq auth_type "oauth2")}}
  accessToken: string;
{{/if}}
{{/if}}
  timeout?: number;
  headers?: Record<string, string>;
}

export class ApiClient {
  private baseUrl: string;
  private headers: Record<string, string>;

  constructor(config: ClientConfig) {
    this.baseUrl = config.baseUrl.replace(/\/$/, "");
{{#if auth}}
{{#if (eq auth_type "bearer")}}
    this.headers = {
      Authorization: `Bearer ${config.token}`,
{{/if}}
{{#if (eq auth_type "api_key")}}
    const apiKeyHeader = config.apiKeyHeader || "X-API-Key";
    this.headers = {
      [apiKeyHeader]: config.apiKey,
{{/if}}
{{#if (eq auth_type "basic")}}
    const credentials = Buffer.from(`${config.username}:${config.password}`).toString("base64");
    this.headers = {
      Authorization: `Basic ${credentials}`,
{{/if}}
{{#if (eq auth_type "oauth2")}}
    this.headers = {
      Authorization: `Bearer ${config.accessToken}`,
{{/if}}
{{/if}}
    this.headers = {
      "Content-Type": "application/json",
      ...config.headers,
    };
  }

  private async request<T>(
    method: string,
    path: string,
    options: {
      params?: Record<string, any>;
      data?: any;
      headers?: Record<string, string>;
    } = {}
  ): Promise<T> {
    let url = `${this.baseUrl}${path}`;
    const { params, data, headers } = options;

    if (params) {
      const searchParams = new URLSearchParams();
      Object.entries(params).forEach(([key, value]) => {
        if (value !== undefined && value !== null) {
          searchParams.append(key, String(value));
        }
      });
      const queryString = searchParams.toString();
      if (queryString) url += `?${queryString}`;
    }

    const response = await fetch(url, {
      method,
      headers: { ...this.headers, ...headers },
      body: data ? JSON.stringify(data) : undefined,
    });

    if (!response.ok) {
      const error = await response.text();
      throw new Error(`HTTP ${response.status}: ${error}`);
    }

    if (response.status === 204) {
      return undefined as T;
    }

    return response.json();
  }

  async get<T>(path: string, options?: { params?: Record<string, any>; headers?: Record<string, string> }): Promise<T> {
    return this.request<T>("GET", path, options);
  }

  async post<T>(path: string, options?: { data?: any; headers?: Record<string, string> }): Promise<T> {
    return this.request<T>("POST", path, options);
  }

  async put<T>(path: string, options?: { data?: any; headers?: Record<string, string> }): Promise<T> {
    return this.request<T>("PUT", path, options);
  }

  async patch<T>(path: string, options?: { data?: any; headers?: Record<string, string> }): Promise<T> {
    return this.request<T>("PATCH", path, options);
  }

  async delete<T>(path: string, options?: { headers?: Record<string, string> }): Promise<T> {
    return this.request<T>("DELETE", path, options);
  }
}

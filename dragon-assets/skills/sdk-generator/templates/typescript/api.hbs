    {{/each}}
    {{#if request_body}}
    const data = { {{#each request_body.fields}}
      {{name}}: {{name}}{{#unless @last}},
      {{/unless}}
    {{/each}} };
    return this.client.{{method}}(path, {
      {{#each query_params}}
      params: { {{name}} },
      {{/each}}
      data,
    });
    {{/if}}
    {{#unless request_body}}
    return this.client.{{method}}(path, {
      {{#each query_params}}
      params: { {{name}} },
      {{/each}}
    });
    {{/unless}}
  }

  {{/each}}
}

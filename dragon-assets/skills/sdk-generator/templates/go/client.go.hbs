func (c *Client) buildURL(path string, params map[string]interface{}) string {
	result := c.baseURL + path
	if len(params) > 0 {
		query := url.Values{}
		for k, v := range params {
			if v == nil {
				continue
			}
			switch val := v.(type) {
			case string:
				query.Add(k, val)
			case int:
				query.Add(k, strconv.Itoa(val))
			case int64:
				query.Add(k, strconv.FormatInt(val, 10))
			case float64:
				query.Add(k, strconv.FormatFloat(val, 'f', -1, 64))
			case bool:
				query.Add(k, strconv.FormatBool(val))
			case []string:
				for _, item := range val {
					query.Add(k, item)
				}
			default:
				query.Add(k, fmt.Sprintf("%v", val))
			}
		}
		if len(query) > 0 {
			result += "?" + query.Encode()
		}
	}
	return result
}

func (c *Client) doRequest(ctx context.Context, method, path string, params map[string]interface{}, body interface{}) ([]byte, int, error) {
	url := c.buildURL(path, params)

	var reqBody io.Reader
	if body != nil {
		data, err := json.Marshal(body)
		if err != nil {
			return nil, 0, fmt.Errorf("failed to marshal request body: %w", err)
		}
		reqBody = bytes.NewReader(data)
	}

	req, err := http.NewRequestWithContext(ctx, method, url, reqBody)
	if err != nil {
		return nil, 0, fmt.Errorf("failed to create request: %w", err)
	}

	for k, v := range c.headers {
		req.Header.Set(k, v)
	}

	var lastErr error
	for attempt := 0; attempt <= c.maxRetries; attempt++ {
		resp, err := c.httpClient.Do(req)
		if err != nil {
			lastErr = fmt.Errorf("request failed: %w", err)
			if attempt < c.maxRetries {
				time.Sleep(c.retryDelay * time.Duration(1<<attempt))
				continue
			}
			return nil, 0, lastErr
		}
		defer resp.Body.Close()

		body, err := io.ReadAll(resp.Body)
		if err != nil {
			return nil, resp.StatusCode, fmt.Errorf("failed to read response body: %w", err)
		}

		switch resp.StatusCode {
		case http.StatusNoContent:
			return nil, resp.StatusCode, nil
		case http.StatusTooManyRequests:
			retryAfter := c.retryDelay
			if ra := resp.Header.Get("Retry-After"); ra != "" {
				if seconds, err := strconv.Atoi(ra); err == nil {
					retryAfter = time.Duration(seconds) * time.Second
				}
			}
			if attempt < c.maxRetries {
				time.Sleep(retryAfter * time.Duration(1<<attempt))
				continue
			}
			return nil, resp.StatusCode, &RateLimitError{
				APIError:    APIError{Message: "Rate limit exceeded", StatusCode: resp.StatusCode, Response: string(body)},
				RetryAfter: retryAfter,
			}
		case http.StatusNotFound:
			return nil, resp.StatusCode, &NotFoundError{
				APIError: APIError{Message: fmt.Sprintf("Resource not found: %s", path), StatusCode: resp.StatusCode, Response: string(body)},
			}
		case http.StatusUnauthorized:
			return nil, resp.StatusCode, &UnauthorizedError{
				APIError: APIError{Message: "Authentication failed", StatusCode: resp.StatusCode, Response: string(body)},
			}
		case http.StatusUnprocessableEntity:
			return nil, resp.StatusCode, &ValidationError{
				APIError: APIError{Message: "Validation failed", StatusCode: resp.StatusCode, Response: string(body)},
			}
		case http.StatusOK, http.StatusCreated, http.StatusAccepted:
			return body, resp.StatusCode, nil
		default:
			return nil, resp.StatusCode, &APIError{
				Message:    fmt.Sprintf("HTTP %d", resp.StatusCode),
				StatusCode: resp.StatusCode,
				Response:   string(body),
			}
		}
	}

	return nil, 0, lastErr
}


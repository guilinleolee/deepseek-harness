# Pixelle-Video Environment Configuration
# Copy this file to .env and configure

# =============================================================================
# ComfyUI Server
# =============================================================================
COMFYUI_HOST=localhost
COMFYUI_PORT=8188
COMFYUI_URL=http://localhost:8188

# =============================================================================
# API Settings
# =============================================================================
# API timeout in seconds
API_TIMEOUT=300

# Enable/disable API authentication
API_AUTH_ENABLED=false
API_KEY=

# =============================================================================
# Model Paths
# =============================================================================
# Path to ComfyUI models directory
COMFYUI_MODELS_DIR=./ComfyUI/models

# Model categories
CHECKPOINTS_DIR=${COMFYUI_MODELS_DIR}/checkpoints
VAE_DIR=${COMFYUI_MODELS_DIR}/vae
AUDIO_DIR=${COMFYUI_MODELS_DIR}/audio
CLIP_DIR=${COMFYUI_MODELS_DIR}/clip
LORAS_DIR=${COMFYUI_MODELS_DIR}/loras

# =============================================================================
# Workflow Settings
# =============================================================================
# Default workflow
DEFAULT_WORKFLOW=full-auto

# Workflow directory
WORKFLOWS_DIR=./workflows

# Output directory for generated videos
OUTPUT_DIR=./output

# =============================================================================
# Video Settings
# =============================================================================
# Default resolution
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512
# Options: 480p, 720p, 1080p
DEFAULT_RESOLUTION=480p

# Default FPS
DEFAULT_FPS=24

# =============================================================================
# TTS Settings (ChatTTS)
# =============================================================================
# Voice preset
# Options: female_young, female_mature, male_young, male_mature
DEFAULT_VOICE=female_young

# Temperature for TTS (0.0-1.0, lower = more stable)
TTS_TEMPERATURE=0.3

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

LOG_FILE=pixelle-video.log

# =============================================================================
# GPU Settings
# =============================================================================
# GPU device ID (0 = first GPU)
GPU_DEVICE=0

# Enable mixed precision
MIXED_PRECISION=true

# =============================================================================
# Security
# =============================================================================
# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Enable rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# Storage
# =============================================================================
# Maximum storage for generated files (GB)
MAX_STORAGE_GB=100

# Auto-cleanup generated files older than (days)
CLEANUP_AFTER_DAYS=7

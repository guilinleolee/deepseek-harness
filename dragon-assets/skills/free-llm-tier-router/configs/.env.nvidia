# ===== Claude Code 配置 =====
# 用于本地 LLM 代理服务
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_BASE_URL=http://localhost:8082

# ===== NVIDIA NIM Provider 配置 =====
# Tier: OPUS (复杂推理)
# 模型: claude-3-opus, claude-3-haiku, llama-3.1-nemotron-70b-instruct
# 特点: 企业级、低延迟高可用、NVIDIA GPU 优化
# 定价: 按量计费 (https://developer.nvidia.com/nim)
# 申请地址: https://org.nvidia.com/

# NVIDIA API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Tier Router 配置 =====
DEFAULT_TIER=opus
FALLBACK_ENABLED=true
LOCAL_PROVIDER=ollama
FALLBACK_ENABLED=true

# ===== OPUS Tier 模型配置 =====
# OPUS Tier: 复杂推理、架构设计、安全审计
OPUS_PROVIDER=nvidia
OPUS_MODEL=claude-3-opus
OPUS_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== HAUKU Tier 模型配置 =====
# HAIKU Tier: 快速分类、摘要、简单问答
HAIKU_PROVIDER=nvidia
HAIKU_MODEL=claude-3-haiku
HAIKU_BASE_URL=https://integrate.api.nvidia.com/v1

# ===== Tier Router 统计配置 =====
STATS_FILE=.stats.jsonl
LOG_LEVEL=INFO
TRACE_ROUTING=true

# ===== Claude Code 配置 =====
# 用于本地 LLM 代理服务
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_BASE_URL=http://localhost:8082

# ===== DeepSeek Provider 配置 =====
# Tier: HAIKU + SONNET
# 模型: deepseek-chat-v3-0324 (快速), deepseek-reasoner (推理)
# 特点: 高性价比、中文优化、推理能力强
# 定价: $0.001/M input, $0.001/M output (Chat V3)
#         $0.002/M input, $0.008/M output (Reasoner)
# 申请地址: https://platform.deepseek.com/api_keys

# DeepSeek API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Tier Router 配置 =====
DEFAULT_TIER=sonnet
FALLBACK_ENABLED=true
LOCAL_PROVIDER=ollama

# ===== SONNET Tier 模型配置 =====
# SONNET Tier: 平衡推理、代码、文档
# 使用 DeepSeek Reasoner 进行推理优化
SONNET_PROVIDER=deepseek
SONNET_MODEL=deepseek-reasoner
SONNET_BASE_URL=https://api.deepseek.com
SONNET_COST_INPUT=0.002
SONNET_COST_OUTPUT=0.008

# ===== HAIKU Tier 模型配置 =====
# HAIKU Tier: 快速分类、摘要、简单问答
# 使用 DeepSeek Chat V3 进行高速响应
HAIKU_PROVIDER=deepseek
HAIKU_MODEL=deepseek-chat-v3-0324
HAIKU_BASE_URL=https://api.deepseek.com
HAIKU_COST_INPUT=0.001
HAIKU_COST_OUTPUT=0.001

# ===== Tier Router 统计配置 =====
STATS_FILE=.stats.jsonl
LOG_LEVEL=INFO
TRACE_ROUTING=true

# ===== DeepSeek 特定配置 =====
# 推理思考长度 (Reasoner 模型)
DEEPSEEK_THINKING_TOKEN_LIMIT=16000

# Chat 模型参数
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2048

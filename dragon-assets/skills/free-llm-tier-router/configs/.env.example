# ===== Claude Code 配置 =====
# 用于本地 LLM 代理服务
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_BASE_URL=http://localhost:8082

# ===== Provider API Keys (至少配置一个) =====

# OpenRouter (推荐，支持 Claude/GPT-4o/Gemini 等 100+ 模型)
# 申请地址: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek (性价比高，推理优化)
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM (企业级，低延迟高可用)
# 申请地址: https://org.nvidia.com/
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 默认路由策略 =====

# 默认 Tier: local | haiku | sonnet | opus
DEFAULT_TIER=sonnet

# 启用自动降级 (Provider 不可用时自动切换)
FALLBACK_ENABLED=true

# ===== 本地 Provider 配置 =====

# 默认本地 Provider: ollama | lmstudio | llamacpp
LOCAL_PROVIDER=ollama

# ===== Tier Router 统计配置 =====

# 统计文件路径
STATS_FILE=.stats.jsonl

# 成本参考 (美元/千 Token)
# LOCAL:  $0 (免费)
# HAIKU: $0.001 in + $0.001 out (DeepSeek/Claude Haiku)
# SONNET: $0.003 in + $0.015 out (Claude Sonnet)
# OPUS:   $0.015 in + $0.075 out (Claude Opus)

# ===== 日志配置 =====

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 是否记录详细路由决策
TRACE_ROUTING=true

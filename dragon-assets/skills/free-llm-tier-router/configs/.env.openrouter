# ===== Claude Code 配置 =====
# 用于本地 LLM 代理服务
ANTHROPIC_AUTH_TOKEN=freecc
ANTHROPIC_BASE_URL=http://localhost:8082

# ===== OpenRouter Provider 配置 =====
# Tier: SONNET + OPUS
# 模型: claude-3.5-sonnet, claude-3-opus, claude-3-haiku, GPT-4o, Gemini 等 100+ 模型
# 特点: 模型聚合、按量计费、自动选择最优模型
# 定价: 各模型不同 (https://openrouter.ai/models)
# 申请地址: https://openrouter.ai/keys

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Tier Router 配置 =====
DEFAULT_TIER=sonnet
FALLBACK_ENABLED=true
LOCAL_PROVIDER=ollama

# ===== OPUS Tier 模型配置 =====
# OPUS Tier: 复杂推理、架构设计、安全审计
OPUS_PROVIDER=openrouter
OPUS_MODEL=anthropic/claude-3-opus
OPUS_BASE_URL=https://openrouter.ai/api/v1
OPUS_COST_INPUT=0.015
OPUS_COST_OUTPUT=0.075

# ===== SONNET Tier 模型配置 =====
# SONNET Tier: 平衡推理、代码、文档
SONNET_PROVIDER=openrouter
SONNET_MODEL=anthropic/claude-3.5-sonnet
SONNET_BASE_URL=https://openrouter.ai/api/v1
SONNET_COST_INPUT=0.003
SONNET_COST_OUTPUT=0.015

# ===== HAIKU Tier 模型配置 =====
# HAIKU Tier: 快速分类、摘要、简单问答
HAIKU_PROVIDER=openrouter
HAIKU_MODEL=anthropic/claude-3-haiku
HAIKU_BASE_URL=https://openrouter.ai/api/v1
HAIKU_COST_INPUT=0.001
HAIKU_COST_OUTPUT=0.001

# ===== Tier Router 统计配置 =====
STATS_FILE=.stats.jsonl
LOG_LEVEL=INFO
TRACE_ROUTING=true

# ===== OpenRouter 特定配置 =====
# 站点标识 (可选，用于 OpenRouter 统计)
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_SITE_NAME=DragonEngine

# 请求偏好
OPENROUTER_MAX_LATENCY=10000
OPENROUTER_TRY_SCALE_IN=true
